# Default: short, revalidating. The 1-year "immutable" cache belongs ONLY on
# fingerprinted assets (see /assets/* rules below). Applying it to /* froze
# llms.txt and every extensionless page (/contact/, /automation) at the edge
# for a year, so content and GEO updates never reached crawlers.
/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/llms.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/logo/*
  Cache-Control: public, max-age=31536000, immutable
