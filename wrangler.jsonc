// Cloudflare Workers (static assets) config for xvision.co.il
// Goal: serve the site EXACTLY like GitHub Pages does today — .html URLs stay .html (200, no redirect).
// html_handling "none" disables Cloudflare's forced pretty-URL redirects; cloudflare-worker.js
// fills the one gap that leaves (serving index.html for "/" and for directory paths like /about-us/).
{
  "name": "xvision-website",
  "compatibility_date": "2026-07-15",
  "main": "cloudflare-worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  // T093: leads are stored here before any mail is sent. Namespace "LEADS" created by Alon 5.11.2026.
  // D1 (Nir's choice) attaches as binding "LEADS_DB" once the database exists — the worker uses both.
  "kv_namespaces": [
    { "binding": "LEADS", "id": "d5932eade4ee4d2cb04edf598d0691e9" }
  ]
}
